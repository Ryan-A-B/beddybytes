# Copy this file to config/local.sops.env, replace every value, then encrypt it
# before committing it. See README.md for the complete setup instructions.
ENCRYPTION_KEY=REPLACE_BEFORE_ENCRYPTING
JWT_SIGNING_KEY=REPLACE_BEFORE_ENCRYPTING
# This token must be signed by JWT_SIGNING_KEY.
TINYANALYTICS_WRITE_TOKEN=REPLACE_BEFORE_ENCRYPTING
# Required Google OIDC settings. Use the local OAuth client.
GOOGLE_CLIENT_ID=REPLACE_WITH_LOCAL_CLIENT_ID_BEFORE_ENCRYPTING
GOOGLE_CLIENT_SECRET=REPLACE_WITH_LOCAL_CLIENT_SECRET_BEFORE_ENCRYPTING
# Register https://api.local.beddybytes.com/auth/google/callback in Google.
# Production Traefik redirects it to api.beddybytes.local, preserving code/state.
# Compose fixes API_ORIGIN to the public relay and FRONTEND_AUTH_REDIRECT to
# https://app.beddybytes.local/auth/callback.
