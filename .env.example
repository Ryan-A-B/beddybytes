# Copy this file to config/local.sops.env, replace every value, then encrypt it
# before committing it. See README.md for the complete setup instructions.
ENCRYPTION_KEY=REPLACE_BEFORE_ENCRYPTING
JWT_SIGNING_KEY=REPLACE_BEFORE_ENCRYPTING
# This token must be signed by JWT_SIGNING_KEY.
TINYANALYTICS_WRITE_TOKEN=REPLACE_BEFORE_ENCRYPTING
# Required Google OIDC settings. Use the QA OAuth client for local testing.
GOOGLE_CLIENT_ID=REPLACE_WITH_QA_CLIENT_ID_BEFORE_ENCRYPTING
GOOGLE_CLIENT_SECRET=REPLACE_WITH_QA_CLIENT_SECRET_BEFORE_ENCRYPTING
# Google returns to its registered QA callback. In the same browser session,
# rewrite only that callback's host to api.beddybytes.local, keeping code/state.
# Selenium can intercept that navigation and rewrite it before QA receives it.
API_ORIGIN=https://api.qa.beddybytes.com
FRONTEND_AUTH_REDIRECT=https://app.beddybytes.local/auth/callback
